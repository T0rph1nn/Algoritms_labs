<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Task2_Target" targetNamespace="http://example.com/task2">
  <bpmn:process id="Process_Target_Data_Collection" name="Сбор и анализ данных в целевой архитектуре розничного предприятия" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Старт по расписанию"/>
    <bpmn:task id="Task_ExtractOperational" name="Извлечь данные из текущих систем"/>
    <bpmn:task id="Task_ExtractSocial" name="Извлечь данные из BrandAnalytics"/>
    <bpmn:task id="Task_LoadStaging" name="Загрузить данные в staging"/>
    <bpmn:task id="Task_CleanNormalize" name="Очистить и нормализовать данные"/>
    <bpmn:exclusiveGateway id="Gateway_Quality" name="Данные прошли контроль качества?"/>
    <bpmn:task id="Task_LoadDWH" name="Загрузить факты и измерения в ХД"/>
    <bpmn:task id="Task_BuildMarts" name="Построить витрины данных"/>
    <bpmn:task id="Task_Analyze" name="Рассчитать KPI и прогноз закупок"/>
    <bpmn:task id="Task_UpdateBI" name="Обновить BI-дашборды"/>
    <bpmn:task id="Task_LogErrors" name="Записать ошибки качества данных"/>
    <bpmn:endEvent id="EndEvent_Success" name="Аналитика обновлена"/>
    <bpmn:endEvent id="EndEvent_Error" name="Требуется исправление данных"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ExtractOperational"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ExtractOperational" targetRef="Task_ExtractSocial"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ExtractSocial" targetRef="Task_LoadStaging"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_LoadStaging" targetRef="Task_CleanNormalize"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_CleanNormalize" targetRef="Gateway_Quality"/>
    <bpmn:sequenceFlow id="Flow_6" name="Да" sourceRef="Gateway_Quality" targetRef="Task_LoadDWH"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_LoadDWH" targetRef="Task_BuildMarts"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_BuildMarts" targetRef="Task_Analyze"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Analyze" targetRef="Task_UpdateBI"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_UpdateBI" targetRef="EndEvent_Success"/>
    <bpmn:sequenceFlow id="Flow_11" name="Нет" sourceRef="Gateway_Quality" targetRef="Task_LogErrors"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_LogErrors" targetRef="EndEvent_Error"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Task2">
    <bpmndi:BPMNPlane id="BPMNPlane_Task2" bpmnElement="Process_Target_Data_Collection">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="120" y="140" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExtractOperational_di" bpmnElement="Task_ExtractOperational"><dc:Bounds x="210" y="118" width="180" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExtractSocial_di" bpmnElement="Task_ExtractSocial"><dc:Bounds x="430" y="118" width="180" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LoadStaging_di" bpmnElement="Task_LoadStaging"><dc:Bounds x="650" y="118" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CleanNormalize_di" bpmnElement="Task_CleanNormalize"><dc:Bounds x="850" y="118" width="180" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Quality_di" bpmnElement="Gateway_Quality" isMarkerVisible="true"><dc:Bounds x="1080" y="133" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LoadDWH_di" bpmnElement="Task_LoadDWH"><dc:Bounds x="1180" y="70" width="180" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuildMarts_di" bpmnElement="Task_BuildMarts"><dc:Bounds x="1400" y="70" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Analyze_di" bpmnElement="Task_Analyze"><dc:Bounds x="1610" y="70" width="190" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateBI_di" bpmnElement="Task_UpdateBI"><dc:Bounds x="1840" y="70" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogErrors_di" bpmnElement="Task_LogErrors"><dc:Bounds x="1180" y="210" width="180" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success"><dc:Bounds x="2050" y="92" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Error_di" bpmnElement="EndEvent_Error"><dc:Bounds x="1420" y="232" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="156" y="158"/><di:waypoint x="210" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="390" y="158"/><di:waypoint x="430" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="610" y="158"/><di:waypoint x="650" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="810" y="158"/><di:waypoint x="850" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1030" y="158"/><di:waypoint x="1080" y="158"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1105" y="133"/><di:waypoint x="1105" y="110"/><di:waypoint x="1180" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1360" y="110"/><di:waypoint x="1400" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1570" y="110"/><di:waypoint x="1610" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1800" y="110"/><di:waypoint x="1840" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="2010" y="110"/><di:waypoint x="2050" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1105" y="183"/><di:waypoint x="1105" y="250"/><di:waypoint x="1180" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1360" y="250"/><di:waypoint x="1420" y="250"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
